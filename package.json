{
  "name": "nxts-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "nxts monorepo.",
  "license": "MIT",
  "author": "chentao.arthur",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "auk dev --workspace",
    "dev:app": "pnpm --filter @nxts/app dev",
    "build": "auk build --workspace",
    "publish:alpha": "auk publish --workspace --version alpha --token env:NPM_TOKEN",
    "publish:beta": "auk publish --workspace --version beta --token env:NPM_TOKEN",
    "publish:patch": "auk publish --workspace --version patch --token env:NPM_TOKEN",
    "publish:minor": "auk publish --workspace --version minor --token env:NPM_TOKEN",
    "publish:major": "auk publish --workspace --version major --token env:NPM_TOKEN",
    "test": "pnpm -r --if-present test",
    "typecheck": "tsc -p . --noEmit --skipLibCheck && tsc -p app --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt --write --ignore-path .gitignore \"**/*.{js,mjs,cjs,ts,tsx,json,md,css,html}\""
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "auklet": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yaml,yml,css}": "oxfmt --write"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "=10.27.0"
  },
  "packageManager": "pnpm@10.27.0"
}
